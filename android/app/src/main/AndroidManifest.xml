<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="true" />
    <!-- Companion association (restarts the link from the background); the app also works without. -->
    <uses-feature
        android:name="android.software.companion_device_setup"
        android:required="false" />

    <!-- Scanning never derives the phone's location. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Fingerprint unlock of the signed-in session (a normal permission: no prompt). -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Companion device (normal permissions, no prompt): run in the background and start the
         foreground service from the background when the associated watch is in range, and
         ask the system for presence callbacks. -->
    <uses-permission android:name="android.permission.REQUEST_COMPANION_RUN_IN_BACKGROUND" />
    <uses-permission android:name="android.permission.REQUEST_COMPANION_START_FOREGROUND_SERVICES_FROM_BACKGROUND" />
    <uses-permission android:name="android.permission.REQUEST_OBSERVE_COMPANION_DEVICE_PRESENCE" />
    <!--
        Phone features (stage 2f, all off until switched on in the Watch tab). Find my phone rings
        the alarm stream, vibrates and asks for the full screen over the lock screen. Reading
        notifications and the music player needs "Notification access", which the owner gives in
        system settings (not a manifest permission).
    -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!--
        usesCleartextTraffic: the owner's server may be plain http on the LAN or the tailnet
        (the tailnet encrypts the link itself). The upload carries a bearer token, so use
        https or a tailnet address whenever the server is reachable from anywhere else.
    -->
    <!-- Seeing Garmin Connect lets the Watch screen explain that only one app can talk to the watch. -->
    <queries>
        <package android:name="com.garmin.android.apps.connectmobile" />
        <!-- The apps with a launcher icon, for the list of apps whose notifications stay on the phone. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".NimragApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.Nimrag"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true">
        <!-- The embedded web view: Safe Browsing stays on (also set on the web view itself). -->
        <meta-data
            android:name="android.webkit.WebView.EnableSafeBrowsing"
            android:value="true" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density|fontScale|locale|layoutDirection"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".engine.WatchService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- Bound by the system when the associated watch appears; starts WatchService. -->
        <service
            android:name=".engine.WatchPresenceService"
            android:exported="true"
            android:permission="android.permission.BIND_COMPANION_DEVICE_SERVICE">
            <intent-filter>
                <action android:name="android.companion.CompanionDeviceService" />
            </intent-filter>
        </service>

        <!--
            Notification access (system settings). Bound by the system once the owner enables it;
            reads nothing unless "Notifications on the watch" or "Music" is on.
        -->
        <service
            android:name=".engine.phone.NimragNotificationListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Find my phone: "Found it" over the lock screen while the phone rings. -->
        <activity
            android:name=".engine.phone.FindPhoneActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:showWhenLocked="true"
            android:taskAffinity=""
            android:turnScreenOn="true" />

        <!-- "Found it" on the notification (only our own PendingIntent sends it). -->
        <receiver
            android:name=".engine.phone.FindPhoneReceiver"
            android:exported="false" />

        <receiver
            android:name=".engine.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- The auto-sync alarm (AlarmManager, only our own PendingIntent sends it). -->
        <receiver
            android:name=".engine.AutoSyncReceiver"
            android:exported="false" />
    </application>
</manifest>
