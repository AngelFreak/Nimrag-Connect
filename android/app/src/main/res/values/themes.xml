<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Window theme: only what shows before Compose draws (splash and window background). DayNight
      follows the system dark mode. Everything on screen is themed by NimragTheme in Compose.
    -->
    <style name="Theme.Nimrag" parent="android:Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
