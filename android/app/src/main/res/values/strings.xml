    <string name="garmin_info_title">Nimrag syncs your watch</string>
    <string name="garmin_info_body">Nimrag must be the only app that syncs the watch. If Garmin Connect is installed, keep its Nearby devices permission off.</string>
    <string name="garmin_forward_heading">Keep Garmin Connect up to date</string>
    <string name="garmin_forward_body">In your Nimrag profile, open \"Send to Garmin\" and connect your Garmin account. Your server then sends your activities, or everything from the watch, to your own Garmin account.</string>
    <string name="garmin_forward_row">Send to Garmin</string>
